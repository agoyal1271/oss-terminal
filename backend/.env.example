# `auto` uses Tradier when TRADIER_TOKEN exists, otherwise Yahoo.
# Production should use `tradier` so a missing/expired token fails closed.
OPTIONS_PROVIDER=auto
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TTL_OPTIONS=30

# Existing optional settings
FRED_API_KEY=
IV_SNAPSHOT_SECRET=
