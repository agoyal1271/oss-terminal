# Copy to scripts/.env (gitignored) and fill in. Only slack_bot.py reads this
# file; ask.py and scan_signals.py take plain env vars (matching how the
# GitHub Actions workflows already configure them).

# Bot User OAuth Token from the Slack app's "OAuth & Permissions" page
# (starts xoxb-, NOT xoxp- -- a user token posts as you, not as a bot).
# Scopes needed: channels:history, channels:read, chat:write
# (add groups:history + groups:read too if #equity-alerts is private).
# The bot must also be INVITED to the channel (/invite @your-bot-name).
SLACK_BOT_TOKEN=xoxb-...

# Channel ID (starts with C) or name (with or without #).
SLACK_CHANNEL=equity-alerts

# Optional overrides -- defaults shown.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# POLL_INTERVAL_SECONDS=20
# COMMAND_PREFIX=?ask
# BACKEND_URL=https://backend-gules-iota-44.vercel.app
# FRONTEND_URL=https://frontend-pi-blue-13.vercel.app
